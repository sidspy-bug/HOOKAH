API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Agent 1 (Gemini Cloud): full-text paper structuring
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_STAGE_TIMEOUT_SECONDS=40

# Agent 2 (GPU Qwen via remote Ollama): main reasoning
GPU_OLLAMA_BASE_URL=http://127.0.0.1:11434
GPU_OLLAMA_MODEL=qwen2.5:14b-instruct
GPU_OLLAMA_TEMPERATURE=0.15
GPU_OLLAMA_KEEP_ALIVE=8m
GPU_STAGE_TIMEOUT_SECONDS=55

# Agent 3 (Local LLaMA via Ollama): critic/refiner
CRITIC_OLLAMA_BASE_URL=http://127.0.0.1:11434
CRITIC_OLLAMA_MODEL=llama3.1:8b-instruct
CRITIC_OLLAMA_TEMPERATURE=0.1
CRITIC_OLLAMA_KEEP_ALIVE=4m
CRITIC_STAGE_TIMEOUT_SECONDS=25

# End-to-end pipeline budget (seconds)
MAX_PIPELINE_SECONDS=118

# Legacy/general Ollama settings (kept for backward compatibility)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_MAX_RETRIES=2
OLLAMA_KEEP_ALIVE=5m
ENABLE_GEMINI_FALLBACK=0
